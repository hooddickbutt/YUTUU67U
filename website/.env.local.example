# Copy to .env.local and fill in.

# From https://cloud.reown.com (free) — needed for real WalletConnect support.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=f4362b1ea4735c7f157bbe07a65b3df2

# Fill this in after deploying the contract (see /hardhat/README.md).
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x6a25D7E96256e7317925845dF639862865D1d6AB

# "testnet" (default) or "mainnet" — switches the whole site's active chain.
NEXT_PUBLIC_NETWORK=testnet

# Optional — defaults to https://ipfs.io/ipfs/bafybeicdbkwzcjkc772bnxmgt6ipsrobazf6swovluu6znikbofa67si4m/2222
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/bafybeicdbkwzcjkc772bnxmgt6ipsrobazf6swovluu6znikbofa67si4m/2222

# Free API key from https://dashboard.alchemy.com — used by the Staking
# page to look up which Mini Brokers NFTs the connected wallet owns.
NEXT_PUBLIC_ALCHEMY_API_KEY=alch_NhKEi-ICXC5cch2V8aHeF
